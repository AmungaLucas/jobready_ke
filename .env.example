# ============================================================================
# JobReady KE — Environment Variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# ---------------------------------------------------------------------------
# DATABASE_URL — MySQL connection string
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?params
#
# Shared-host notes (cPanel / DirectAdmin / Plesk):
#   - These hosts typically cap concurrent connections per DB user (often 3-10).
#     Use connection_limit=3 to stay under the cap.
#   - Add pool_timeout=60 to tolerate slow handshakes on remote MariaDB servers.
#   - Do NOT enable SSL unless you've confirmed the server supports it
#     (many cPanel MariaDB instances disable SSL on the listening port).
# ---------------------------------------------------------------------------
DATABASE_URL=mysql://jobready_intel_admin:Admincyber@d7.my-control-panel.com:3306/jobready_intel?connection_limit=3&connect_timeout=30&socket_timeout=60&pool_timeout=60

# ---------------------------------------------------------------------------
# NextAuth.js
#   - NEXTAUTH_SECRET: generate with `openssl rand -base64 32`
#   - NEXTAUTH_URL:   public URL of the deployed app (no trailing slash)
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET=dev-secret-change-me-in-production
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Gemini 1.5 Flash API key — used for CV/JD extraction (Phase 2)
# If unset, the platform falls back to a deterministic stub that produces the
# same JSON shape, so dev/demo can run without burning API tokens.
# Get a key at: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
